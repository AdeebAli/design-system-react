{
  "name": "@adeebali/design-system-react",
  "version": "0.1.0",
  "description": "A personal React design system.",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/styles/**"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdeebAli/design-system-react.git"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "build": "vite build --config vite.lib.config.ts && node scripts/build-fonts.mjs && node scripts/verify-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-raw-values.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit && node --test scripts/*.test.mjs",
    "dev": "storybook dev -p 6006",
    "build:storybook": "storybook build -o storybook-static --quiet",
    "test:stories": "vitest run --project 'stories-*' --project browser",
    "test:visual": "playwright test",
    "test:fixtures": "node scripts/test-fixtures.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:stories && npm run build && npm run test:fixtures",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@microsoft/api-extractor": "^7.60.1",
    "@playwright/test": "1.65.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import-x": "^4.18.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "inter-ui": "^4.1.1",
    "jsdom": "^31.0.0",
    "lucide-react": "^1.70.0",
    "playwright": "1.65.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.6",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/sprinkles": "^1.7.1"
  }
}
